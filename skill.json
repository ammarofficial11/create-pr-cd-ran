{
  "schemaVersion": "1.0",
  "skillId": "create-pr-cd-ran",
  "displayName": "Create PR CD RAN",
  "version": "1.1.2",
  "runtime": {
    "type": "python",
    "entrypoint": "src/main.py",
    "minimumPython": "3.11"
  },
  "inputs": {
    "files": [
      {
        "name": "bom",
        "required": true,
        "multiple": false,
        "acceptedExtensions": [".xlsx"],
        "maximumBytes": 104857600
      },
      {
        "name": "epms",
        "required": true,
        "multiple": false,
        "acceptedExtensions": [".xlsx"],
        "maximumBytes": 104857600
      }
    ],
    "parametersSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runMode"],
      "properties": {
        "runMode": { "type": "string", "enum": ["standard-pr", "general-item"] },
        "selectedProject": { "type": "string" }
      }
    }
  },
  "ui": {
    "schemaVersion": "1.0",
    "workerLabel": "RAN PR Worker",
    "hero": {
      "title": "Launch PR Creator jobs with MW PR and RAN PR modes.",
      "subtitle": "Launch MW PR or RAN PR jobs with validated inputs, live progress, and controlled result delivery from one dedicated PR Creator route.",
      "chips": ["RAN PR Worker", "Validate"],
      "includeModeChip": true
    },
    "workbench": { "title": "PR Creator" },
    "actions": {
      "primaryLabel": "Create Job",
      "readyLabel": "Ready to create Job",
      "missingFilesMessage": "Upload both BOM and EPMS workbooks to start.",
      "validationMessage": "Validate both BOM and EPMS workbooks before creating a Job.",
      "missingParametersMessage": "Select a project for General Item mode."
    },
    "uploads": {
      "bom": {
        "title": "BOM Upload",
        "label": "BOM workbook",
        "hint": "Upload the source BOM workbook required for the RAN PR worker.",
        "actionLabel": "Validate BOM",
        "validationRequired": true
      },
      "epms": {
        "title": "EPMS Upload",
        "label": "EPMS workbook",
        "hint": "Upload the EPMS workbook required for RAN matching and General Item logic.",
        "actionLabel": "Validate EPMS",
        "validationRequired": true
      }
    },
    "configuration": {
      "mode": {
        "field": "runMode",
        "labels": { "standard-pr": "Standard PR", "general-item": "General Item" }
      },
      "switcher": {
        "label": "PR Creator Mode",
        "options": [
          { "skillId": "create-pr-cd", "label": "MW PR", "routeName": "pr-creator" },
          { "skillId": "create-pr-cd-ran", "label": "RAN PR", "routeName": "ran-pr-creator" }
        ]
      },
      "fieldOrder": ["runMode", "selectedProject"],
      "emptyStates": [
        {
          "visibleWhen": { "field": "runMode", "equals": "standard-pr" },
          "text": "Standard PR runs non-interactively after BOM and EPMS validation."
        },
        {
          "visibleWhen": { "field": "runMode", "equals": "general-item" },
          "text": "Select a workbook-backed General Item project after both uploads validate."
        }
      ]
    },
    "parameters": {
      "runMode": {
        "label": "Run mode",
        "control": "segmented",
        "options": [
          { "value": "standard-pr", "label": "Standard PR" },
          { "value": "general-item", "label": "General Item" }
        ]
      },
      "selectedProject": {
        "label": "General Item project",
        "control": "select",
        "placeholder": "Select a validated project",
        "options": [
          { "value": "2023 Celcomdigi BAU", "label": "2023 Celcomdigi BAU" },
          { "value": "2024 Celcomdigi BAU", "label": "2024 Celcomdigi BAU" },
          { "value": "2025 NIC revisit", "label": "2025 NIC revisit" },
          { "value": "CD consolidation 2023 (Decomm RAN)", "label": "CD consolidation 2023 (Decomm RAN)" },
          { "value": "CD consolidation 2023 (Decomm TX)", "label": "CD consolidation 2023 (Decomm TX)" },
          { "value": "CD consolidation 2023 (Swap/ Modernize)", "label": "CD consolidation 2023 (Swap/ Modernize)" },
          { "value": "CR with Equipment", "label": "CR with Equipment" },
          { "value": "Celcomdigi USP", "label": "Celcomdigi USP" },
          { "value": "Decomm Cabinet CR", "label": "Decomm Cabinet CR" },
          { "value": "Decomm Reuse", "label": "Decomm Reuse" },
          { "value": "Highways Add Sec", "label": "Highways Add Sec" },
          { "value": "Imacro BBU Swap", "label": "Imacro BBU Swap" },
          { "value": "MSQos_2025", "label": "MSQos_2025" },
          { "value": "NIC congest upgrade", "label": "NIC congest upgrade" },
          { "value": "Project Thanos", "label": "Project Thanos" }
        ],
        "disabledWhen": { "field": "runMode", "equals": "standard-pr" },
        "requiredWhen": { "field": "runMode", "equals": "general-item" }
      }
    }
  },
  "execution": {
    "timeoutSeconds": 3600,
    "supportsCancellation": true,
    "cancellation": { "type": "sentinelFile", "path": "temp/cancel.requested" },
    "limits": { "progressHeartbeatSeconds": 30 }
  },
  "resultContractVersion": "1.0",
  "release": {
    "packageIdentity": "git-commit-plus-runtime-sha256",
    "notes": "BOM, EPMS, project validation, calculation, and workbook generation remain owned by this Python skill."
  }
}
